# Every pinned version, digest and checksum the k8s/ tooling uses. Change a
# version and its checksums together, taking each checksum from the upstream
# file named next to it. Where upstream publishes none, the pin is the sha256
# of the artifact as downloaded from its release when the pin was set.
# shellcheck disable=SC2034

# kind: https://github.com/kubernetes-sigs/kind/releases (kind-linux-<arch>.sha256sum)
KIND_VERSION=v0.33.0
KIND_SHA256_amd64=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
KIND_SHA256_arm64=20022bee6cfcd5086cb7234d218e3454e6090022f2a8f55d1fa7fcf42c3867a2
# The digest is the one the kind release notes list for this kind version.
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5

# kubectl: https://dl.k8s.io/release/<version>/bin/linux/<arch>/kubectl.sha256
KUBECTL_VERSION=v1.37.1
KUBECTL_SHA256_amd64=65691ff77eb6fa44c908b77a1082c9f092c3b9733b5cefabec0d1104890e21a8
KUBECTL_SHA256_arm64=ff749f4b78d9c4f1ec87307df9b50119ed819e2094aa9810cb9acffc3286c8c7

# helm renders the Traefik chart only (helm template); nothing is installed as a
# helm release. https://get.helm.sh/helm-<version>-linux-<arch>.tar.gz.sha256sum
HELM_VERSION=v3.22.0
HELM_SHA256_amd64=1e4ab49e429626cf6c6958d914248b78c9730803c2751b87627e171dc800e7bb
HELM_SHA256_arm64=f14e804dfee240f55525b667488fe9adca349e63e00c9af634c0beb1421ac310

# cmctl: https://github.com/cert-manager/cmctl/releases (checksums.txt)
CMCTL_VERSION=v2.6.1
CMCTL_SHA256_amd64=0af054c26a2b64ce286fa868d029164867695a93c3eb893662ce16f35e708db0
CMCTL_SHA256_arm64=0261c9dc17711659548a1cb9014326f47cf472a699b48150fe133ae17054cf8c

# cert-manager: https://github.com/cert-manager/cert-manager/releases (no
# checksum file; sha256 of cert-manager.yaml from the release)
CERT_MANAGER_VERSION=v1.21.2
CERT_MANAGER_SHA256=e03b668ec8675214af6b0a671699d088f2601fa3878e0dbe1b41d3feafd1879f

# Traefik chart: https://traefik.github.io/charts/index.yaml (entries.traefik[].digest)
TRAEFIK_CHART_VERSION=41.6.0
TRAEFIK_CHART_SHA256=cd7254ea853da73bdb88edc896f079b88d43ffa0bfe699fdbf21081361eac365

# Test app: the multi-arch index digest from Docker Hub for this tag.
WHOAMI_IMAGE=traefik/whoami:v1.12.0@sha256:c4717a8d1f0134a7444e24f881160e033991f23027c6c5a9a3f8fd22e70d1d44

# Check tools for CI (task k8s:check). linux amd64 only.
# task: https://github.com/go-task/task/releases (task_checksums.txt)
TASK_VERSION=v3.53.1
TASK_SHA256_amd64=a54a408f6861ff921f6e87774180db31bacd8c1e7c944ca696db9fea49a82fc7
# kubeconform: https://github.com/yannh/kubeconform/releases (CHECKSUMS)
KUBECONFORM_VERSION=v0.8.0
KUBECONFORM_SHA256_amd64=9bc2bffbf71f261128533edaf912153948b7ff238f9a531ae6d34466ec287883
# ShellCheck: https://github.com/koalaman/shellcheck/releases (no checksum
# file; sha256 of the release tarball)
SHELLCHECK_VERSION=v0.11.0
SHELLCHECK_SHA256_amd64=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198
