# The lab Fleet Manager operator CA (openssl ca). Rendered by operator-ca/ca.sh
# init into the CA folder; run openssl ca from inside that folder.

[ ca ]
default_ca = operator_ca

[ operator_ca ]
dir              = .
database         = $dir/index.txt
new_certs_dir    = $dir/newcerts
certificate      = $dir/operator-ca.crt
private_key      = $dir/operator-ca.key
serial           = $dir/serial
crlnumber        = $dir/crlnumber
default_md       = sha384
default_days     = 365
default_crl_days = 7
unique_subject   = no
# Never copy extensions from the CSR: the sections below are the policy.
copy_extensions  = none
# Keep only the CN from the CSR subject.
policy           = policy_cn_only
crl_extensions   = crl_ext

[ policy_cn_only ]
commonName = supplied

# OpenSSL has no section include, so each level repeats the common lines. The
# level extension must stay non-critical: Go's verifier refuses a client cert
# with an unhandled critical extension. Its value is the DER the manager's
# cmd/opext prints.

[ op_admin ]
basicConstraints       = critical, CA:FALSE
keyUsage               = critical, digitalSignature
extendedKeyUsage       = clientAuth
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid
authorityInfoAccess    = OCSP;URI:${LAB_OPCA_OCSP_URL}
1.3.6.1.4.1.59999.1.1 = DER:13:05:61:64:6D:69:6E

[ op_operator ]
basicConstraints       = critical, CA:FALSE
keyUsage               = critical, digitalSignature
extendedKeyUsage       = clientAuth
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid
authorityInfoAccess    = OCSP;URI:${LAB_OPCA_OCSP_URL}
1.3.6.1.4.1.59999.1.1 = DER:13:08:6F:70:65:72:61:74:6F:72

[ op_viewer ]
basicConstraints       = critical, CA:FALSE
keyUsage               = critical, digitalSignature
extendedKeyUsage       = clientAuth
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid
authorityInfoAccess    = OCSP;URI:${LAB_OPCA_OCSP_URL}
1.3.6.1.4.1.59999.1.1 = DER:13:06:76:69:65:77:65:72

[ crl_ext ]
authorityKeyIdentifier = keyid

# A delegated OCSP signer, so the responder runs without the CA key.
[ ocsp_signer ]
basicConstraints       = critical, CA:FALSE
keyUsage               = critical, digitalSignature
extendedKeyUsage       = OCSPSigning
noCheck                = ignored
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid
