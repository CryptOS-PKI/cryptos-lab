# Copy to .env (gitignored) and fill in. Never commit real values.
export GOVC_URL="https://<esxi-or-vcenter-host>/sdk"
export GOVC_USERNAME="root"
export GOVC_PASSWORD="<password>"
export GOVC_INSECURE=1

# Lab VM / target settings
export LAB_VM="cryptos-lab"
export LAB_DATASTORE="DATASTORE"
export LAB_NETWORK="Datacenter"
export LAB_ISO_PATH="ISO/cryptos-amd64-vmware.iso"   # datastore-relative
export LAB_ISO_LOCAL="build/out/cryptos-amd64-vmware.iso"
export LAB_DISK_GB="20"

# Kubernetes lab (k8s/, task k8s:*). Task arguments (ACME_URL=, CA_BUNDLE=,
# HOST=) override these.
export LAB_K8S_CLUSTER="cryptos-lab"
export LAB_K8S_HOST="whoami.lab.example.org"      # resolves to this box on the lab resolver
export LAB_ACME_URL="https://intermediate.lab.example.org/acme/directory"
export LAB_CA_BUNDLE="$HOME/cryptos-lab/root.pem"  # the CryptOS root certificate (PEM)
export LAB_ACME_EAB_KID=""                         # External Account Binding key id, if the node requires one
export LAB_ACME_EAB_HMAC=""                        # its base64url HMAC key; secret, never logged
export LAB_K8S_ADDR="127.0.0.1"                    # where k8s:verify connects; the box's LAN address, e.g. 192.0.2.10, also works
export LAB_K8S_WAIT_SECONDS="300"
export LOG_LEVEL="trace"                           # trace | debug | info | warn | error
